<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LayoutFixer</AssemblyName>
    <RootNamespace>LayoutFixer</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Позволява компилиране и на Linux/macOS (напр. в CI), без да се пуска -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Product>Грешна подредба</Product>
    <Description>Поправя текст, написан с грешна клавиатурна подредба (латиница/кирилица).</Description>
    <Company>Радослав Чакъров</Company>
    <Copyright>© Радослав Чакъров</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LayoutFixer.Core\LayoutFixer.Core.csproj" />
  </ItemGroup>

</Project>
